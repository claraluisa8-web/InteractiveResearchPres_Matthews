  "issues": [
    {
      "id": 1,
      "section": "idempotencyKey",
      "title": "Idempotency-Key is never checked",
      "builderSays": "The API gateway already rejects duplicate requests, so the handler doesn’t check the key.",
      "reviewerSays": "The gateway isn’t in this spec. The spec returns 409 when a key is reused, so check it here.",
      "specExcerpt": {
        "file": "recurring-investments.yaml",
        "lines": [
          25,
          28
        ]
      },
      "flaggedLines": [
        "// Gateway rejects duplicate requests upstream",
        "Plan plan = planService.create(request);"
      ],
      "lineNotes": {
        "@RequestHeader(\"Idempotency-Key\")": "read, never checked",
        "// Gateway rejects duplicate requests upstream": "{reviewer}: check the key here"
      },
      "acceptFixResult": "data/code/PlanController.reviewer-fix.java (issue 1 part)",
      "resolvedWhen": "The saved createPlan body references idempotencyKey in a condition before planService.create(...) (any reasonable check counts), OR the user clicks Accept {reviewer}’s fix."
    },
    {
      "id": 2,
      "section": "createdResponse",
      "title": "201 response has no Location header",
      "builderSays": "The response body already includes the plan id, so clients can find the plan.",
      "reviewerSays": "The spec’s PlanCreated response includes a Location header. Return it with the 201.",
      "specExcerpt": {
        "file": "recurring-investments.yaml",
        "lines": [
          17,
          20
        ]
      },
      "flaggedLines": [
        "return ResponseEntity.status(HttpStatus.CREATED)"
      ],
      "acceptFixResult": "data/code/PlanController.reviewer-fix.java (issue 2 part)",
      "resolvedWhen": "The saved code mentions Location / URI / ResponseEntity.created(...), OR the user accepts the fix.",
      "new": true
    }
