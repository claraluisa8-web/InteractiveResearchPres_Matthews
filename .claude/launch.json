{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "prototype",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "prototype-src",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "site-built",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8001",
        "--directory",
        "_site"
      ],
      "port": 8001
    }
  ]
}
