{
  "$description": "Design tokens for The Pre-Merge Review (spatial concept, Figma page 'Hi-Fi Screens (Spatial) v9'). Shared by the prototype and the restyled tree map. Every text/background pairing here was checked to WCAG AAA (7:1 body, 4.5:1 large).",
  "color": {
    "canvas": {
      "base": "#050A12",
      "gradient": { "type": "linear", "direction": "to bottom", "stops": [["#050A12", 0], ["#07101E", 0.55], ["#0C1A36", 1]] },
      "floorGlow": { "color": "#3050FF", "opacity": 0.22, "blur": 140, "note": "Ellipse 1700x560 centered under the bottom edge (top at y=700 of a 900px viewport)." },
      "grid": { "color": "#6B8FCC", "opacity": 0.16, "centerLinesOpacity": 0.22, "strokeWidth": 1 },
      "vignette": { "type": "radial", "stops": [["rgba(0,0,0,0)", 0], ["rgba(0,0,0,0)", 0.62], ["rgba(0,0,0,0.55)", 1]] },
      "scrim": { "color": "#050A12", "opacity": 0.6 }
    },
    "text": {
      "primary": "#F2F5FA",
      "secondary": "#B8CAE2",
      "onAccent": "#0B0F1A",
      "link": "#B3ADFF",
      "note": "There is ONE secondary text color. Hierarchy comes from size and weight, never from darker greys."
    },
    "accent": {
      "lavender": "#8A82FD",
      "lavenderUse": "Non-text only: rings, checkbox fill, send button, active-tab bar, caret, progress, non-urgent alerts.",
      "buttonPrimary": "#9D96FF",
      "buttonPrimaryText": "#0B0F1A",
      "chipTint": "rgba(138,130,253,0.18)",
      "chipText": "#D4D0FF"
    },
    "status": {
      "issue": "#FF4D5E",
      "issueUse": "Red is ONLY for issues: issue lines, issue dots, issue row bars.",
      "issueBadge": "#A8182A",
      "issueBadgeText": "#FFFFFF",
      "issueText": "#FFB8BF",
      "issueRowTint": "rgba(255,77,94,0.12)",
      "issuePill": { "fill": "rgba(255,77,94,0.16)", "stroke": "rgba(255,77,94,0.55)" },
      "cleared": "#3EE6A8",
      "working": "#7CC4FF",
      "workingLine": "rgba(124,196,255,0.6)",
      "connectedLine": "rgba(255,255,255,0.16)",
      "pendingLine": "dashed rgba(242,245,250,0.6)",
      "suggestedLine": "dotted rgba(242,245,250,0.4)"
    },
    "surface": {
      "glass": { "fill": "rgba(20,28,48,0.72)", "tint": "rgba(138,130,253,0.05)", "stroke": "rgba(255,255,255,0.10)", "backdropBlur": 24, "shadow": "0 16px 40px rgba(0,0,0,0.45)" },
      "popup": { "fill": "rgba(20,28,48,0.90)", "tint": "rgba(138,130,253,0.05)", "stroke": "rgba(255,255,255,0.10)", "backdropBlur": 24, "shadow": "0 16px 40px rgba(0,0,0,0.45)" },
      "codePanel": { "fill": "#1E2A47", "stroke": "rgba(255,255,255,0.10)" },
      "input": "rgba(255,255,255,0.04)",
      "inputLocked": "rgba(255,255,255,0.02)",
      "buttonSecondary": { "fill": "rgba(255,255,255,0.06)", "stroke": "rgba(255,255,255,0.16)" },
      "buttonDisabled": { "fill": "rgba(255,255,255,0.03)", "stroke": "rgba(255,255,255,0.10)", "text": "#B8CAE2" },
      "rowHover": "rgba(255,255,255,0.06)",
      "rowSelected": "rgba(255,255,255,0.04)",
      "rowHighlight": "rgba(255,255,255,0.05)",
      "titleBar": "rgba(3,6,12,0.92)",
      "activeTab": "#0E1628",
      "divider": "rgba(255,255,255,0.08)"
    },
    "agent": {
      "you": { "name": "Pearl", "dot": "#F2F5FA" },
      "builder": { "name": "Blue", "base": "#3D7BFF", "cardStroke": "rgba(61,123,255,0.35)", "chipText": "#C9D8FF" },
      "reviewer": { "name": "Violet", "base": "#7C5CFF", "cardStroke": "rgba(124,92,255,0.35)", "chipText": "#D9CCFF" },
      "tester": { "name": "Mint", "base": "#3EE6A8" },
      "other": { "name": "Gold", "base": "#FFC857" },
      "teammate": { "name": "Iridescent ring" }
    },
    "code": {
      "default": "#DCE3EE",
      "keyword": "#D4C2FF",
      "type": "#9DD4FF",
      "string": "#9BE7C4",
      "annotation": "#FFC857",
      "comment": "#B8CAE2",
      "lineNumber": "#B8CAE2",
      "lineNumberNote": "Line numbers are 1px smaller than the code so they sit behind it.",
      "caret": "#8A82FD"
    }
  },
  "orb": {
    "$note": "Recreate as CSS radial/linear gradients + blurred swirl ellipses. Sizes in the design: You 64px, agents 48px (near) / 36px (far), list icons 24px, inline 18px. Each orb has a 1px rgba(255,255,255,0.22) border (scaled) and a soft floor reflection ellipse below it (agent color at 40%, blur 5).",
    "you": { "gradient": ["#F6F2FF", "#DDD4FF", "#C3D6FF"], "glow": "rgba(185,168,255,0.45) 0 0 20px", "swirls": [["#C77DFF", 0.85], ["#4C7DFF", 0.95], ["#FFFFFF", 0.7]], "highlight": ["#FFFFFF", 0.45], "rings": ["80px circle, rgba(255,255,255,0.20) 1.5px", "108px circle, rgba(255,255,255,0.07) 1px"] },
    "builder": { "gradient": ["#1E3BFF", "#3D7BFF", "#5CE1FF"], "glow": "rgba(61,123,255,0.60) 0 0 19px", "swirls": [["#8AF5FF", 0.9], ["#141A86", 0.85]], "icon": "white sparkle/grid glyph" },
    "reviewer": { "gradient": ["#4B2BD9", "#7C5CFF", "#C3A6FF"], "glow": "rgba(124,92,255,0.60) 0 0 19px", "swirls": [["#E6B3FF", 0.85], ["#24157A", 0.85]], "icon": "white eye glyph" },
    "tester": { "gradient": ["#0FAF8A", "#3EE6A8", "#D7F26B"], "glow": "rgba(62,230,168,0.50) 0 0 19px", "swirls": [["#EEFF9A", 0.9], ["#0A6466", 0.8]], "icon": "dark #06231B beaker glyph" },
    "other": { "gradient": ["#B5800F", "#FFC857", "#FFF1BF"], "glow": "rgba(255,200,87,0.45) 0 0 19px", "swirls": [["#FFF4C8", 0.9], ["#6E4308", 0.75]], "icon": "dark #2A1A00 glyph, varies by agent type" },
    "teammate": { "fill": "#0E1626", "ring": "conic-gradient(#F6F2FF 0, #C3A6FF 30%, #5CE1FF 60%, #D7F26B 85%, #F6F2FF 100%) 2.5px", "ringTones": ["conic-gradient(#FFF1BF 0, #FFC857 35%, #FF9E7A 65%, #FFF1BF 100%)", "conic-gradient(#D7F26B 0, #3EE6A8 40%, #5CE1FF 70%, #D7F26B 100%)", "conic-gradient(#C3D6FF 0, #3D7BFF 40%, #5CE1FF 70%, #C3D6FF 100%)"], "glow": "rgba(195,166,255,0.35) 0 0 15px", "content": "initials, Red Hat Text 600, #F2F5FA" },
    "gradientAngle": "135deg (light from top-left)",
    "suggested": "dashed 1.5px circle outline, no fill, icon in #B8CAE2",
    "notAddedYet": "dashed ring around a dim orb with label 'Not added yet'",
    "nonUrgentRing": "2px #8A82FD ring + 6px dot at top-right",
    "verifiedBadge": "18px #3EE6A8 circle with dark check, top-right of orb"
  },
  "type": {
    "families": {
      "ui": "'Red Hat Text', system-ui, sans-serif",
      "mono": "'Red Hat Mono', ui-monospace, monospace",
      "note": "Exactly two typefaces. No emoji or fallback glyphs: arrows, links and icons are drawn icons (Codicons)."
    },
    "scale": {
      "panelTitle": { "size": 18, "weight": 600, "lineHeight": 24 },
      "issueTitle": { "size": 14, "weight": 600 },
      "name": { "size": 13, "weight": 600, "lineHeight": 17 },
      "body": { "size": 13, "weight": 400, "lineHeight": 20 },
      "button": { "size": 13, "weight": 500 },
      "detail": { "size": 12, "weight": 400, "lineHeight": 16 },
      "meta": { "size": 11, "weight": 400, "lineHeight": 15 },
      "label": { "size": 11, "weight": 600, "letterSpacing": "0.08em", "transform": "uppercase" },
      "composer": { "size": 14, "weight": 400 },
      "codeInline": { "family": "mono", "size": 12, "lineHeight": 16 },
      "codeEditor": { "family": "mono", "size": 13, "lineHeight": 23 },
      "fileName": { "family": "mono", "size": 13, "weight": 500 }
    }
  },
  "radius": { "panel": 16, "popup": 20, "card": 12, "button": 10, "input": 8, "chip": 11.5, "statusPill": 20, "composer": 28, "menuRow": 8, "menuRowInGlass": 4 },
  "size": { "viewport": [1440, 900], "titleBar": 36, "button": 34, "statusPill": 41, "composer": [640, 58], "checkbox": 18 },
  "opticalRules": [
    "Bounding boxes get slightly more bottom and right padding than top and left (cards +2px bottom, large panels +4px bottom).",
    "Text inside pills, buttons and inputs sits about 1px below the mathematical center; pills get 1-2px extra bottom padding.",
    "Plus icons are centered on the glyph, not the padded icon box, and sit 0.5-1px low.",
    "Check marks inside circles sit 0.5px below the icon box center (glyph ink centered on the circle).",
    "Section headers are nudged 0.5px right.",
    "The status pill keeps a fixed right margin; lists grow to keep their right padding."
  ],
  "motion": {
    "rule": "Enterprise calm: no automatic camera moves or zooms. The user may zoom/pan the constellation themselves.",
    "durations": { "hover": 120, "panel": 200, "crossfade": 200 },
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "reducedMotion": "Respect prefers-reduced-motion: drop transitions to instant."
  }
}
